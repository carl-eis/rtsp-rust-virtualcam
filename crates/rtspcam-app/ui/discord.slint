// The Discord tab: a bot that sends an audio device's sound into a voice channel
// (documentation/19). The Rust side is src/ui/discord_tab.rs.

import { Button, CheckBox, ComboBox, GroupBox, LineEdit, Palette, Slider } from "std-widgets.slint";
import { ErrorText, Label, Row } from "common.slint";

export global DiscordTab {
    // This build has the Discord tab (the `discord` cargo feature).
    in property <bool> available;
    // `discord.json` couldn't be read; shown at the top.
    in property <string> settings-error;

    // ----- Bot -----
    in-out property <string> token;
    in-out property <bool> show-token;
    // A token is saved (the field stays empty; typing one replaces it).
    in property <bool> has-token;
    // Logged in or logging in: the button says "Log out".
    in property <bool> running;
    in property <string> status-text;
    in property <bool> failed;
    in property <string> hint;
    in property <bool> can-invite;
    in-out property <bool> auto-login;

    // ----- Voice -----
    in property <[string]> servers;
    in-out property <int> server: -1;
    in property <[string]> channels;
    in-out property <int> channel: -1;
    in property <bool> online;
    in property <bool> in-voice;
    in property <string> voice-text;
    in property <string> notice;
    in property <string> notice-hint;

    // ----- Sound -----
    in property <[string]> devices;
    in-out property <int> device: -1;
    in property <string> input-text;
    in property <bool> input-failed;
    in-out property <bool> gate-enabled: true;
    in-out property <float> threshold: -50;
    // The level going out, in dBFS (-90 is silence).
    in property <float> peak: -90;
    in property <float> rms: -90;
    in property <bool> gate-open;
    in property <bool> metering;
    in-out property <bool> muted: true;

    callback login();
    callback logout();
    callback invite();
    callback setup-help();
    callback auto-login-changed(bool);
    callback server-chosen(int);
    callback join();
    callback leave();
    callback refresh-devices();
    callback device-chosen(int);
    callback gate-changed();
    callback toggle-mute();
}

// The level meter: RMS as a bar, the peak as a thin line, the gate threshold as a marker.
// Green while the gate lets sound through.
component Meter inherits Rectangle {
    in property <float> peak;
    in property <float> rms;
    in property <float> threshold;
    in property <bool> open;
    in property <bool> active;
    property <float> floor: -90;

    height: 14px;
    border-radius: 3px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    Rectangle {
        x: 0;
        width: root.active ? parent.width * max(0, (root.rms - root.floor) / -root.floor) : 0;
        height: parent.height;
        background: root.open ? #2e9d4c : #8a8a8a;
        animate width { duration: 60ms; }
    }

    Rectangle {
        x: parent.width * max(0, (root.peak - root.floor) / -root.floor) - 2px;
        width: 2px;
        height: parent.height;
        visible: root.active && root.peak > root.floor;
        background: root.open ? #1f6f35 : #5a5a5a;
    }

    // The gate threshold.
    Rectangle {
        x: parent.width * max(0, (root.threshold - root.floor) / -root.floor) - 1px;
        width: 2px;
        height: parent.height;
        background: #d13438;
    }
}

export component DiscordPage inherits VerticalLayout {
    padding: 10px;
    spacing: 10px;

    if !DiscordTab.available: Label {
        text: "This build of RTSP Cam has no Discord support.";
    }

    if DiscordTab.settings-error != "": ErrorText {
        text: "discord.json can't be read, so changes here won't be saved until it is fixed or deleted: " + DiscordTab.settings-error;
    }

    if DiscordTab.available: GroupBox {
        title: "Bot";
        VerticalLayout {
            spacing: 6px;
            Row {
                label: "Bot token";
                token-edit := LineEdit {
                    horizontal-stretch: 1;
                    text <=> DiscordTab.token;
                    input-type: DiscordTab.show-token ? InputType.text : InputType.password;
                    placeholder-text: DiscordTab.has-token ? "Saved (paste a new token to replace it)" : "Paste the token from the Developer Portal";
                    enabled: !DiscordTab.running;
                    accepted => {
                        DiscordTab.login();
                    }
                }

                Button {
                    text: "Paste";
                    enabled: !DiscordTab.running;
                    clicked => {
                        token-edit.select-all();
                        token-edit.paste();
                    }
                }

                CheckBox {
                    text: "Show";
                    checked <=> DiscordTab.show-token;
                }

                Button {
                    text: DiscordTab.running ? "Log out" : "Log in";
                    min-width: 90px;
                    enabled: DiscordTab.running || DiscordTab.has-token || DiscordTab.token != "";
                    clicked => {
                        if (DiscordTab.running) {
                            DiscordTab.logout();
                        } else {
                            DiscordTab.login();
                        }
                    }
                }
            }

            Row {
                label: "Status";
                Label {
                    horizontal-stretch: 1;
                    text: DiscordTab.status-text;
                    color: DiscordTab.failed ? #d13438 : Palette.foreground;
                    wrap: word-wrap;
                }
            }

            if DiscordTab.hint != "": Row {
                label: "";
                Label {
                    horizontal-stretch: 1;
                    text: DiscordTab.hint;
                    wrap: word-wrap;
                }
            }

            Row {
                label: "";
                CheckBox {
                    text: "Log in when RTSP Cam starts";
                    checked <=> DiscordTab.auto-login;
                    toggled => {
                        DiscordTab.auto-login-changed(self.checked);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Invite to a server";
                    enabled: DiscordTab.can-invite;
                    clicked => {
                        DiscordTab.invite();
                    }
                }

                Button {
                    text: "How to set up a bot";
                    clicked => {
                        DiscordTab.setup-help();
                    }
                }
            }
        }
    }

    if DiscordTab.available: GroupBox {
        title: "Voice";
        VerticalLayout {
            spacing: 6px;
            Row {
                label: "Server";
                ComboBox {
                    horizontal-stretch: 1;
                    model: DiscordTab.servers;
                    current-index <=> DiscordTab.server;
                    enabled: DiscordTab.online;
                    selected => {
                        DiscordTab.server-chosen(self.current-index);
                    }
                }
            }

            Row {
                label: "Channel";
                ComboBox {
                    horizontal-stretch: 1;
                    model: DiscordTab.channels;
                    current-index <=> DiscordTab.channel;
                    enabled: DiscordTab.online;
                }

                Button {
                    text: "Join";
                    min-width: 90px;
                    enabled: DiscordTab.online && DiscordTab.channel >= 0;
                    clicked => {
                        DiscordTab.join();
                    }
                }

                Button {
                    text: "Leave";
                    min-width: 90px;
                    enabled: DiscordTab.in-voice;
                    clicked => {
                        DiscordTab.leave();
                    }
                }
            }

            Row {
                label: "";
                Label {
                    horizontal-stretch: 1;
                    text: DiscordTab.voice-text;
                    wrap: word-wrap;
                }
            }

            if DiscordTab.notice != "": Row {
                label: "";
                ErrorText {
                    horizontal-stretch: 1;
                    text: DiscordTab.notice + (DiscordTab.notice-hint != "" ? "\n" + DiscordTab.notice-hint : "");
                }
            }
        }
    }

    if DiscordTab.available: GroupBox {
        title: "Sound";
        VerticalLayout {
            spacing: 6px;
            Row {
                label: "Source";
                ComboBox {
                    horizontal-stretch: 1;
                    model: DiscordTab.devices;
                    current-index <=> DiscordTab.device;
                    selected => {
                        DiscordTab.device-chosen(self.current-index);
                    }
                }

                Button {
                    text: "Refresh";
                    min-width: 90px;
                    clicked => {
                        DiscordTab.refresh-devices();
                    }
                }
            }

            if DiscordTab.input-text != "": Row {
                label: "";
                Label {
                    horizontal-stretch: 1;
                    text: DiscordTab.input-text;
                    color: DiscordTab.input-failed ? #d13438 : Palette.foreground;
                    wrap: word-wrap;
                }
            }

            Row {
                label: "Level";
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Meter {
                        peak: DiscordTab.peak;
                        rms: DiscordTab.rms;
                        threshold: DiscordTab.gate-enabled ? DiscordTab.threshold : -90;
                        open: DiscordTab.gate-open;
                        active: DiscordTab.metering;
                    }
                }

                Label {
                    width: 70px;
                    text: DiscordTab.metering ? round(DiscordTab.peak) + " dB" : "";
                }
            }

            Row {
                label: "Noise gate";
                CheckBox {
                    text: "Only send sound louder than";
                    checked <=> DiscordTab.gate-enabled;
                    toggled => {
                        DiscordTab.gate-changed();
                    }
                }

                Slider {
                    horizontal-stretch: 1;
                    minimum: -90;
                    maximum: 0;
                    value <=> DiscordTab.threshold;
                    enabled: DiscordTab.gate-enabled;
                    changed => {
                        DiscordTab.gate-changed();
                    }
                }

                Label {
                    width: 70px;
                    text: round(DiscordTab.threshold) + " dB";
                }
            }

            Row {
                label: "";
                Button {
                    text: DiscordTab.muted ? "Unmute (start sending)" : "Mute";
                    min-width: 200px;
                    height: 40px;
                    primary: DiscordTab.muted;
                    clicked => {
                        DiscordTab.toggle-mute();
                    }
                }

                Label {
                    horizontal-stretch: 1;
                    text: DiscordTab.muted ? "Muted: nothing is sent." : "Sending sound.";
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
